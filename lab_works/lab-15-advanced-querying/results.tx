==================================================
8. SUBQUERIES
==================================================

Query:
SELECT first_name, last_name, salary
FROM employees_lab15
WHERE salary > (
    SELECT AVG(salary)
    FROM employees_lab15
)
ORDER BY salary DESC;

 first_name | last_name | salary
------------+-----------+-----------
 Maria      | Garcia    | 130000.00
 James      | Wilson    | 100000.00
 Daniel     | Young     | 90000.00
 Sophia     | Martin    | 85000.00

(4 rows)

Query:
SELECT first_name, last_name, department, salary
FROM employees_lab15
WHERE department IN (
    SELECT department
    FROM employees_lab15
    GROUP BY department
    HAVING AVG(salary) > 80000
)
ORDER BY department, salary DESC;

 first_name | last_name | department  | salary
------------+-----------+-------------+-----------
 James      | Wilson    | Engineering | 100000.00
 Daniel     | Young     | Engineering | 90000.00
 Aiden      | Scott     | Engineering | 75000.00
 Maria      | Garcia    | Management  | 130000.00

(4 rows)

==================================================
9. COMMON TABLE EXPRESSIONS
==================================================

Query:
WITH regional_sales AS (
    SELECT region_id, SUM(amount) AS total_sales
    FROM orders_lab15
    GROUP BY region_id
)
SELECT region_id, total_sales
FROM regional_sales
WHERE total_sales > 100000
ORDER BY region_id;

 region_id | total_sales
-----------+-------------
 1         | 505000.00
 2         | 510000.00

(2 rows)

Query:
WITH department_averages AS (
    SELECT department, AVG(salary) AS avg_salary
    FROM employees_lab15
    GROUP BY department
)
SELECT e.first_name, e.last_name, e.department, e.salary, da.avg_salary
FROM employees_lab15 e
JOIN department_averages da
    ON e.department = da.department
WHERE e.salary > da.avg_salary
ORDER BY e.department, e.salary DESC;

 first_name | last_name | department  | salary    | avg_salary
------------+-----------+-------------+-----------+--------------------
 James      | Wilson    | Engineering | 100000.00 | 88333.333333333333
 Daniel     | Young     | Engineering | 90000.00  | 88333.333333333333
 Sophia     | Martin    | Sales       | 85000.00  | 73333.333333333333

(3 rows)

==================================================
10. RECURSIVE QUERY
==================================================

Query:
WITH RECURSIVE org_chart AS (
    SELECT employee_id, first_name, last_name, manager_id,
           1 AS hierarchy_level
    FROM employees_lab15
    WHERE manager_id IS NULL

    UNION ALL

    SELECT e.employee_id, e.first_name, e.last_name, e.manager_id,
           oc.hierarchy_level + 1
    FROM employees_lab15 e
    INNER JOIN org_chart oc
        ON e.manager_id = oc.employee_id
)
SELECT *
FROM org_chart
ORDER BY hierarchy_level, employee_id;

 employee_id | first_name | last_name | manager_id | hierarchy_level
-------------+------------+-----------+------------+----------------
 1           | Maria      | Garcia    | NULL       | 1
 2           | James      | Wilson    | 1          | 2
 3           | Sophia     | Martin    | 1          | 2
 7           | Emma       | Davis     | 1          | 2
 4           | Daniel     | Young     | 2          | 3
 5           | Olivia     | King      | 3          | 3
 6           | Aiden      | Scott     | 2          | 3
 8           | Noah       | Taylor    | 3          | 3

(8 rows)

